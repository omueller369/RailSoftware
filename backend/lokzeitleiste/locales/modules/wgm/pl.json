  "text_fa75b34eb831": "E-mail WGM",
  "text_62d823660ce7": "Data urodzenia",
  "text_39ecd01bafd5": "Dni urlopu",
  "text_e5ce36cd2280": "Tygodniowy czas pracy (godziny)",
